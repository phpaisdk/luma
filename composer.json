{
    "name": "aisdk/luma",
    "description": "Official Luma provider for the PHP AI SDK.",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "aisdk/core": "^0.10.1"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "nyholm/psr7": "^1.8",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "AiSdk\\Luma\\": "src/",
            "AiSdk\\": "src/Root/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint --test",
        "format": "vendor/bin/pint",
        "analyze": "vendor/bin/phpstan analyze src tests --level=8 --memory-limit=512M",
        "test": "vendor/bin/pest",
        "test:all": [
            "@lint",
            "@analyze",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
